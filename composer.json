{
    "name": "cmsmax/hcaptcha",
    "description": "hCaptcha for Laravel, forked by CMSMax and made compatible with Laravel 12",
    "keywords": [
        "hcaptcha",
        "captcha",
        "laravel"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "scyllaly",
            "email": "scyllaly@github.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "~4.8|^9.5.10|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Scyllaly\\HCaptcha\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Scyllaly\\HCaptcha\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Scyllaly\\HCaptcha\\HCaptchaServiceProvider"
            ],
            "aliases": {
                "HCaptcha": "Scyllaly\\HCaptcha\\Facades\\HCaptcha"
            }
        }
    }
}
